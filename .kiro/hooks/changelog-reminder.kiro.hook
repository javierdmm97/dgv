{
  "enabled": true,
  "name": "Changelog Update Reminder",
  "description": "Reminds you to update CHANGELOG.md if you're committing code changes but haven't updated the changelog",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check if there are staged changes that would require a CHANGELOG.md update. If there are code changes (not just docs/config) staged but CHANGELOG.md is not staged, remind the user to update CHANGELOG.md under [Unreleased] section before committing. If CHANGELOG.md is already staged or only docs/config files are changed, proceed without reminder."
  }
}