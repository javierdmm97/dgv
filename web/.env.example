# Firebase Web app config — copy to .env and fill from the Firebase console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
# These are public client identifiers, not secrets; Firestore security rules are
# what protect the data. We use only Firestore, so no storageBucket / messagingSenderId.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dgv-project-7824a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dgv-project-7824a
VITE_FIREBASE_APP_ID=
